# Copy this file to `.env` and fill in your values.
# The actual `.env` is git-ignored.  Existing shell environment variables
# take precedence over values in `.env`.

# ---------------------------------------------------------------------------
# Currently-used LLM endpoint (DeepSeek for testing)
# ---------------------------------------------------------------------------
VLLM_API_BASE=https://api.deepseek.com/v1
VLLM_MODEL=deepseek-v4-flash
VLLM_API_KEY=sk-replace-me

# ---------------------------------------------------------------------------
# Switch to your local vLLM by replacing the three lines above with these
# (and pointing VLLM_API_BASE at the correct host/port for your server):
# ---------------------------------------------------------------------------
# VLLM_API_BASE=http://192.168.198.141:8000/v1
# VLLM_MODEL=qwen3.5-9B-awq-4bit
# VLLM_API_KEY=test123

# ---------------------------------------------------------------------------
# Optional knobs
# ---------------------------------------------------------------------------
# Make the YANG MCP server read from a different dataset:
# FMA_YANG_DIR=D:\NetworkFaultManagement\data\yang

# Point the simulator-backed PPE MCP server at a specific incidents.db
# (defaults to the merged repo's data/incidents.db):
# FMA_INCIDENTS_DB=C:\ruilin-projects\AIOps_fault_management\data\incidents.db

# Run the PPE / YANG MCP servers as actual stdio subprocesses
# instead of in-process tool calls:
# FMA_PPE_MCP_BACKEND=subprocess
# FMA_YANG_MCP_BACKEND=subprocess

# Force the smoke test / copilot to skip the LLM call:
# FMA_NO_LLM=1
